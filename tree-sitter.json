{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "convex_lisp",
      "camelcase": "ConvexLisp",
      "title": "Convex Lisp",
      "scope": "source.convex_lisp",
      "file-types": [
        "convex_lisp"
      ],
      "injection-regex": "^convex_lisp$",
      "class-name": "TreeSitterConvexLisp"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "A powerful modern Lisp for decentralised systems",
    "authors": [
      {
        "name": "Robert Medeiros",
        "email": "robert@crimeminister.org"
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-convex_lisp"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}