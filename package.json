{
  "name": "tree-sitter-convex-lisp",
  "version": "0.0.1",
  "description": "A tree-sitter grammar for Convex Lisp",
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "parser",
    "lexer"
  ],
  "files": [
    "grammar.js",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**"
  ],
  "scripts": {
    "build": "tree-sitter generate && node-gyp rebuild",
    "build-wasm": "tree-sitter build-wasm",
    "configure": "node-gyp configure",
    "examples": "tree-sitter parse 'examples/**/*.cvx' --quiet --stat",
    "generate": "tree-sitter generate",
    "highlight": "tree-sitter highlight",
    "parse": "tree-sitter parse",
    "test": "tree-sitter test",
    "install": "node-gyp-build",
    "prebuildify": "prebuildify --napi --strip"
  },
  "author": "Robert Medeiros <robert@crimeminister.org>",
  "repository": "https://github.com/crimeminister/tree-sitter-convex-lisp",
  "license": "MIT",
  "dependencies": {
    "node-addon-api": "8.8.0",
    "node-gyp-build": "4.8.4"
  },
  "peerDependencies": {
    "tree-sitter": "0.25.0"
  },
  "peerDependenciesMeta": {
    "tree_sitter": {
      "optional": true
    }
  },
  "devDependencies": {
    "node-gyp": "13.0.0",
    "prebuildify": "6.0.1"
  },
  "tree-sitter": [
    {
      "scope": "source.convex.lisp",
      "file-types": [
        "cvx"
      ]
    }
  ]
}
